# Playwright E2E Test Environment Variables
# Copy this file to .env.test and fill in your test credentials

# Supabase Configuration (use a test instance if available)
NEXT_PUBLIC_SUPABASE_URL=your-test-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key

# Test User Credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test-password

# Optional: JustTCG API Key (for card search tests)
JUSTTCG_API_KEY=your-test-api-key

# Base URL for tests (defaults to http://localhost:3000)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Skip tests if no Supabase test instance configured
# Set to "true" to run tests even without a test database
SKIP_E2E_TESTS_IF_NO_DB=true
